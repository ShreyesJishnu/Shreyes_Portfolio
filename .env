# Absolute URL the site is served from, with a trailing slash.
# Used for canonical + OG/Twitter image tags, which must be absolute — relative
# urls are not reliably resolved by link-preview crawlers.
# CI overrides this with the real GitHub Pages url; change it here if you move
# to a custom domain.
VITE_SITE_URL=https://shreyesjishnu.github.io/Shreyes_Portfolio/
